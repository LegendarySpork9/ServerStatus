@page "/registeralert"

<PageTitle>Register Alert</PageTitle>

@if (IsLoading && Servers == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="@StyleConverter.GetLoadingDarkMode(User.DarkMode)" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

else
{
    <div class="container">
        <div class="@GetStyle("Form") form-grid">
            <label>Reporter:</label>
            <input type="text" style="@GetStyle("Input")" readonly="readonly" @bind="DiscordName" />

            <label>Server:</label>
            <select style="@GetStyle("Input")" @bind="Server">
                <option value="" disabled selected>Select an option</option>
                @foreach (string server in ServersNames)
                {
                    <option value="@server">@server</option>
                }
            </select>

            <label>Component:</label>
            <select style="@GetStyle("Input")" @bind="Component">
                <option value="" disabled selected>Select an option</option>
                <option value="PC">PC</option>
                <option value="Server">Server</option>
                <option value="Connection">Connection</option>
            </select>

            <label>Component Status:</label>
            <select style="@GetStyle("Input")" @bind="ComponentStatus">
                <option value="" disabled selected>Select an option</option>
                <option value="Offline">Offline</option>
                <option value="Unknown">Unknown</option>
            </select>

            @if (ShowError)
            {
                <label class="form-fail">There is already an alert registered for the given details.</label>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <label class="form-fail">@ErrorMessage</label>
            }

            @if (RegisterSuccess)
            {
                <label class="form-full-row text-success">Registered successfully!</label>
            }

            <div class="form-full-row">
                <button class="btn btn-primary" disabled="@Loading" @onclick="RegisterClick">
                    @if (Loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Register
                </button>
            </div>
        </div>
    </div>
}