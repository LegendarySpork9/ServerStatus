@page "/"
@layout Layout.MainLayout

<PageTitle>Home</PageTitle>

<div style="@GetStyle()">
    @if (IsLoading && Servers == null && ComponentEvents.Count == 0)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="@StyleConverter.GetLoadingDarkMode(User.DarkMode)" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }

    else
    {
        @if (Servers != null && Servers.Count > 0 && ComponentEvents.Count > 0)
        {
            @foreach (var server in Servers)
            {
                <div class="server-block">
                    <div class="server-header">
                        <h1>@server.HostName</h1>
                        <p>@server.Game @server.GameVersion</p>
                    </div>
                    <div class="status-row">
                        @foreach (string component in Components)
                        {
                            <div class="status-item">
                                <div class="status-image-wrapper">
                                    <img src="/Images/@(component) Icon.png" />
                                </div>
                                @{
                                    EventModel? componentEvent = ComponentEvents.GetValueOrDefault(component)?.Find(e => e.Server.Id == server.Id);

                                    if (componentEvent != null)
                                    {
                                        <label>@component Status: <span class="@APIConverter.GetStatusClass(componentEvent.Status)">@componentEvent.Status</span></label>
                                    }

                                    else
                                    {
                                        <label>@component Status: <span class="unknown">Unknown</span></label>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        else
        {
            <p class="no-servers-message">No active servers or components registered in API. If this is wrong, please speak with an administrator.</p>
        }
    }
</div>