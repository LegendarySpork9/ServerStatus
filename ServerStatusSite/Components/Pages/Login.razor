@page "/login"
@layout Layout.BlankLayout

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-form">
        <img class="login-icon" src="/Images/favicon.png" />
        <h1>Login</h1>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <label class="login-fail">@ErrorMessage</label>
        }
        <label>Username:</label>
        <input type="text" @bind="User.Username" />
        <label>Password:</label>
        <input type="password" @bind="User.Password" />
        <br />
        <button class="btn btn-primary" disabled="@Loading" @onclick="LoginClick">
            @if (Loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Login
        </button>
    </div>
</div>