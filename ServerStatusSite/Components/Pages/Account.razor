@page "/account"

<PageTitle>Account</PageTitle>

@if (IsLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="@StyleConverter.GetLoadingDarkMode(User.DarkMode)" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

else
{
    <div class="container">
        <div class="@GetStyle("Form") form-grid">
            <div class="form-full-row form-icon">
                <img src="/Images/Account Icon.png" />
            </div>

            <label>Username:</label>
            <input type="text" style="@GetStyle("Input")" @bind="Username" />

            <label>Password:</label>
            <input type="password" style="@GetStyle("Input")" @bind="Password" />

            <label>Discord Name:</label>
            <input type="text" style="@GetStyle("Input")" @bind="DiscordName" />

            <label>Dark Mode:</label>
            <label class="switch">
                <input type="checkbox" @bind="DarkMode">
                <span class="slider round"></span>
            </label>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <label class="form-fail">@ErrorMessage</label>
            }

            @if (SaveSuccess)
            {
                <label class="form-full-row text-success">Saved successfully!</label>
            }

            <div class="form-full-row">
                <button class="btn btn-primary" disabled="@IsLoading" @onclick="SaveClick">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Save
                </button>
            </div>
        </div>
    </div>
}